<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with bright game styling -->
    <style name="Theme.JumpAdventure" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/game_primary_end</item>
        <item name="colorPrimaryVariant">@color/game_primary_shadow</item>
        <item name="colorOnPrimary">#1E293B</item>
        <item name="colorSecondary">@color/game_secondary_end</item>
        <item name="colorSecondaryVariant">@color/game_secondary_shadow</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@color/game_sky_top</item>
    </style>

    <style name="GameTitleText">
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GameSubtitleText">
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
