<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvStarsDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐⭐⭐"
        android:textSize="32sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEVEL COMPLETE"
        android:textColor="#FFD54F"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvCompleteLevelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Level 1"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#1A237E"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvRewardCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 Coins Earned: +230"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvRewardStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Stars Collected: 3/3"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvRewardTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Time: 32.5s"
            android:textColor="@color/text_white"
            android:textSize="14sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnNextLevel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="▶ NEXT LEVEL"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/bg_btn_primary"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReplay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="↻ REPLAY"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_card_rounded"
            android:layout_marginRight="6dp"/>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🏠 HOME"
            android:textColor="@color/text_white"
            android:background="@drawable/bg_card_rounded"/>
    </LinearLayout>

</LinearLayout>
