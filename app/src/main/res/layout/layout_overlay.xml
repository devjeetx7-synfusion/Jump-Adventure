<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B30B1426"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center">

    <!-- Celebration Sparkles Background Layer (Touch Pass-through) -->
    <com.jumpadventure.game.graphics.SparkleView
        android:id="@+id/sparkleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Responsive Board Container for Level Complete and Pause -->
    <FrameLayout
        android:id="@+id/overlayBoardContainer"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/ivPauseBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Dialog Board"
            android:scaleType="fitCenter"
            android:src="@drawable/winner_bg" />

        <LinearLayout
            android:id="@+id/overlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="54dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <!-- Crown / Hero Header Graphic -->
            <ImageView
                android:id="@+id/ivOverlayCrown"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Crown"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hero" />

            <!-- Curved Game Title -->
            <com.jumpadventure.game.graphics.CurvedTitleView
                android:id="@+id/tvOverlayCurvedTitle"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:layout_marginTop="2dp" />

            <!-- Text Header Fallback for Pause / Custom state -->
            <TextView
                android:id="@+id/tvOverlayHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#5A2600"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="2"
                android:text="LEVEL COMPLETE!"
                android:textColor="#FFD43B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOverlaySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="LEVEL 17"
                android:textColor="@color/game_text_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 3D Star Reward Rating -->
            <com.jumpadventure.game.graphics.Stars3DView
                android:id="@+id/vOverlayStars3D"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Text Stars Fallback -->
            <TextView
                android:id="@+id/tvOverlayStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFD43B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Compact Reward Summary Box (Coins / Stars / Time) -->
            <com.jumpadventure.game.graphics.RewardSummaryView
                android:id="@+id/vOverlayRewardSummary"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/rewardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvOverlayCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/game_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/game_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Action Buttons Container -->
            <LinearLayout
                android:id="@+id/dialogButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Full Width Primary Action (NEXT LEVEL / RESUME) -->
                <com.jumpadventure.game.graphics.GamePrimaryButton
                    android:id="@+id/btnOverlayPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp" />

                <!-- Row for Half Width Secondary Actions (RESTART & HOME) -->
                <LinearLayout
                    android:id="@+id/rowSecondaryButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.jumpadventure.game.graphics.GamePrimaryButton
                        android:id="@+id/btnOverlaySecondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <com.jumpadventure.game.graphics.GamePrimaryButton
                        android:id="@+id/btnOverlayHome"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <!-- Vertical Extra Button for Pause (SETTINGS) -->
                <com.jumpadventure.game.graphics.GamePrimaryButton
                    android:id="@+id/btnOverlayExtra"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <com.jumpadventure.game.graphics.GameDialogView
        android:id="@+id/customGameDialog"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />
</RelativeLayout>
