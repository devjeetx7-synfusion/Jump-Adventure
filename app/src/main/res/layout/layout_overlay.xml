<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glossy"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvOverlayHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL COMPLETE"
            android:textColor="#FF9800"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlaySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 1"
            android:textColor="#1B1B2F"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvOverlayStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐⭐⭐"
            android:textSize="32sp"
            android:layout_marginVertical="16dp" />

        <LinearLayout
            android:id="@+id/rewardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvOverlayCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 +230"
                android:textColor="#1B1B2F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ Time: 32.5s"
                android:textColor="#757575"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOverlayPrimary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="▶ NEXT LEVEL"
            android:textColor="#1B1B2F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnOverlaySecondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="↻ REPLAY"
            android:textColor="#1B1B2F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOverlayHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="🏠 HOME"
            android:textColor="#1B1B2F"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
