<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B30B1426"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center">

    <com.jumpadventure.game.graphics.SparkleView
        android:id="@+id/sparkleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/overlayBoardContainer"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:layout_centerInParent="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.jumpadventure.game.graphics.GameDialogBoardView
            android:id="@+id/vDialogBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/overlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/ivOverlayCrown"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <com.jumpadventure.game.graphics.CurvedTitleView
                android:id="@+id/tvOverlayCurvedTitle"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="0dp" />

            <TextView
                android:id="@+id/tvOverlayHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOverlaySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="LEVEL 1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.jumpadventure.game.graphics.Stars3DView
                android:id="@+id/vOverlayStars3D"
                android:layout_width="220dp"
                android:layout_height="72dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="3dp" />

            <com.jumpadventure.game.graphics.RewardSummaryView
                android:id="@+id/vOverlayRewardSummary"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:id="@+id/rewardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dialogButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.jumpadventure.game.graphics.GamePrimaryButton
                    android:id="@+id/btnOverlayPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/rowSecondaryButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.jumpadventure.game.graphics.GamePrimaryButton
                        android:id="@+id/btnOverlaySecondary"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1" />

                    <com.jumpadventure.game.graphics.GamePrimaryButton
                        android:id="@+id/btnOverlayHome"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <com.jumpadventure.game.graphics.GamePrimaryButton
                    android:id="@+id/btnOverlayExtra"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="7dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.jumpadventure.game.graphics.GameDialogView
        android:id="@+id/customGameDialog"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />
</RelativeLayout>
