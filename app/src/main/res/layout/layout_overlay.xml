<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glossy"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvOverlayHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#8B4500"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="2"
            android:text="LEVEL COMPLETE"
            android:textColor="#FFCA28"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlaySub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Level 1"
            android:textColor="@color/game_text_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:text=""
            android:textColor="#FFD54A"
            android:textSize="36sp" />

        <LinearLayout
            android:id="@+id/rewardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/game_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/game_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Action -->
        <Button
            android:id="@+id/btnOverlayPrimary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="▶ NEXT LEVEL"
            android:textColor="@color/game_text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Secondary Action -->
        <Button
            android:id="@+id/btnOverlaySecondary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="↻ REPLAY"
            android:textColor="@color/game_text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Home Action -->
        <Button
            android:id="@+id/btnOverlayHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="HOME"
            android:textColor="@color/game_text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
