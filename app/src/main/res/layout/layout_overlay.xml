<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A90B1A2A"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center">

    <FrameLayout
        android:id="@+id/overlayBoardContainer"
        android:layout_width="292dp"
        android:layout_height="438dp"
        android:layout_centerInParent="true">

        <ImageView
            android:id="@+id/ivPauseBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Pause Board"
            android:scaleType="fitCenter"
            android:src="@drawable/pause_board" />

        <LinearLayout
            android:id="@+id/overlayContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="74dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/tvOverlayHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#5A2600"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="2"
                android:text="PAUSED"
                android:textColor="#FFD43B"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlaySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Level 1"
                android:textColor="@color/game_text_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverlayStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:text=""
                android:textColor="#FFD43B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rewardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOverlayCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/game_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/game_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.jumpadventure.game.graphics.GamePrimaryButton
                android:id="@+id/btnOverlayPrimary"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginBottom="5dp" />

            <com.jumpadventure.game.graphics.GamePrimaryButton
                android:id="@+id/btnOverlaySecondary"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginBottom="5dp" />

            <com.jumpadventure.game.graphics.GamePrimaryButton
                android:id="@+id/btnOverlayHome"
                android:layout_width="220dp"
                android:layout_height="50dp"
                android:layout_marginBottom="3dp" />

        </LinearLayout>
    </FrameLayout>
</RelativeLayout>