<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sky_gradient">

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#1A237E">

        <Button
            android:id="@+id/btnCharactersBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@drawable/bg_card_rounded"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvCharactersTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heroes &amp; Customization"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Sub-tab Selectors (Heroes, Skins, Trails, Pets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#283593"
        android:weightSum="4">

        <Button
            android:id="@+id/tabCharacters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Heroes"
            android:textColor="#FFD54F"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/tabSkins"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Skins"
            android:textColor="@color/text_white"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/tabTrails"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Trails"
            android:textColor="@color/text_white"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/tabPets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Pets"
            android:textColor="@color/text_white"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Items Grid Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/gridCustomization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="true"/>
    </ScrollView>

</LinearLayout>
