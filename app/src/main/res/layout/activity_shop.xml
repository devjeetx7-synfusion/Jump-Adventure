<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sky_gradient">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#1A237E">

        <Button
            android:id="@+id/btnShopBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@drawable/bg_card_rounded"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Shop"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Coin Packs Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COIN BUNDLES"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🪙 Small Pack\n500 Coins"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnBuyCoinsSmall"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:text="CLAIM"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🪙 Large Pack\n5000 Coins"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnBuyCoinsLarge"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:text="CLAIM"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"/>
            </LinearLayout>

            <!-- Power-ups Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POWER-UPS"
                android:textColor="#FFD54F"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🧲 Coin Magnet Boost\nAuto-collect nearby coins"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnBuyMagnet"
                    android:layout_width="110dp"
                    android:layout_height="44dp"
                    android:text="🪙 200"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡 Hazard Shield\nProtect from 1 hit"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnBuyShield"
                    android:layout_width="110dp"
                    android:layout_height="44dp"
                    android:text="🪙 300"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
