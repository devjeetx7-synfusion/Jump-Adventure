<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="16dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/secondaryTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <Button
            android:id="@+id/btnSecondaryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_card_white_rounded"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSecondaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Characters"
            android:textColor="#1B1B2F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_card_white_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSecondaryCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 1250"
                android:textColor="#1B1B2F"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Items Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/secondaryTopBar"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/secondaryContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</RelativeLayout>
