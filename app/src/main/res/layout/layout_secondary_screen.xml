<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Environment Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        android:src="@drawable/home_bg" />

    <!-- Screen-specific Dark/Colored Veil Overlay for Readability -->
    <View
        android:id="@+id/secondaryVeilOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#260B1426" />

    <!-- TOP HUD BAR -->
    <RelativeLayout
        android:id="@+id/secondaryTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnSecondaryBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvSecondaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:shadowColor="#0F172A"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="2"
            android:text="HEROES"
            android:textColor="#FFD43B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Coins Badge -->
        <com.jumpadventure.game.graphics.GameCurrencyBadge
            android:id="@+id/secondaryBadgeCoins"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- SCROLLABLE CONTENT CONTAINER -->
    <ScrollView
        android:id="@+id/secondaryScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/secondaryTopBar"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fadingEdge="none">

        <LinearLayout
            android:id="@+id/secondaryContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</RelativeLayout>
