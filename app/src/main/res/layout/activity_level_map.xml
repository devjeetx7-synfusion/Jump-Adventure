<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky_gradient">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:background="#1A237E">

        <Button
            android:id="@+id/btnMapBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:background="@drawable/bg_card_rounded"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvMapWorldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="World 1 - Green Forest"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Scrollable Level Nodes Map Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/mapHeader"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/levelNodesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal"/>
    </ScrollView>

</RelativeLayout>
