<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- GAME CANVAS CONTAINER -->
    <FrameLayout
        android:id="@+id/gameViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP HUD BAR -->
    <RelativeLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Pause Button -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Pause"
            android:padding="11dp"
            android:src="@drawable/ic_pause" />

        <!-- Center Level Title & Progress Bar -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#0F172A"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="2"
                android:text="LEVEL 1"
                android:textColor="#FFD43B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbLevelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/pb_game_progress" />
        </LinearLayout>

        <!-- Right Collectibles HUD Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Coins Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvHudCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/game_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stars Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/tvHudStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/game_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- POWER-UP ACTION BAR: fixed above the bottom JUMP control, never under the top HUD -->
    <LinearLayout
        android:id="@+id/powerUpBar"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="158dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:elevation="12dp">

        <com.jumpadventure.game.graphics.GamePowerUpButton
            android:id="@+id/btnPowerUpMagnet"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginBottom="9dp"
            android:contentDescription="Magnet power-up" />

        <com.jumpadventure.game.graphics.GamePowerUpButton
            android:id="@+id/btnPowerUpSpeed"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginBottom="9dp"
            android:contentDescription="Speed power-up" />

        <com.jumpadventure.game.graphics.GamePowerUpButton
            android:id="@+id/btnPowerUpShield"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="Shield power-up" />
    </LinearLayout>

</RelativeLayout>
