<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Game Canvas View Container -->
    <FrameLayout
        android:id="@+id/gameViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Bar -->
    <RelativeLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Pause Button -->
        <Button
            android:id="@+id/btnPause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="⏸"
            android:textSize="18sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />

        <!-- Center Level & Progress Bar -->
        <LinearLayout
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHudLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level 1"
                android:textColor="#1B1B2F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbLevelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@android:drawable/progress_horizontal" />
        </LinearLayout>

        <!-- Right Collectibles Count -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_card_glossy"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHudCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 0"
                android:textColor="#1B1B2F"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvHudStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 0"
                android:textColor="#1B1B2F"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Power-up Action Bar (Bottom Right overlay) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@+id/hudBottomPadding"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPowerUpMagnet"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="🧲"
            android:textSize="20sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnPowerUpShield"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="🛡"
            android:textSize="20sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnPowerUpSpeed"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="⚡"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:id="@+id/hudBottomPadding"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
