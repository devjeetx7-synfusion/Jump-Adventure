<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12151C"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Top Bar HUD -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_preferences" />

        <LinearLayout
            android:id="@+id/currencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glossy"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1250 Coins"
                    android:textColor="#1B1B2F"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glossy"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35 Gems"
                    android:textColor="#1B1B2F"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Logo & Title Header -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JUMP\nADVENTURE"
            android:textAlignment="center"
            android:textColor="#FFCA28"
            android:textSize="38sp"
            android:textStyle="bold"
            android:shadowColor="#C62828"
            android:shadowDx="0"
            android:shadowDy="8"
            android:shadowRadius="1" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="PREMIUM PLATFORMER"
            android:textColor="#1B1B2F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Character Display Area (Using dynamic CharacterPreviewView) -->
    <com.jumpadventure.game.graphics.CharacterPreviewView
        android:id="@+id/charPreviewView"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerInParent="true"
        android:layout_marginVertical="8dp" />

    <!-- Primary PLAY Button -->
    <LinearLayout
        android:id="@+id/btnPlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="320dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="PLAY NOW\nLevel 1"
            android:textColor="#1B1B2F"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="SHOP"
            android:drawableTop="@drawable/ic_game_shop"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navCharacters"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="HEROES"
            android:drawableTop="@drawable/ic_game_hero"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navWorlds"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="WORLDS"
            android:drawableTop="@drawable/ic_game_world"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:text="TROPHIES"
            android:drawableTop="@drawable/ic_game_trophy"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textColor="#1B1B2F"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
