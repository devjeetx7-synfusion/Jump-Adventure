<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FULL SCREEN HOME BACKGROUND ASSET -->
    <ImageView
        android:id="@+id/ivHomeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Home Background"
        android:scaleType="centerCrop"
        android:src="@drawable/home_bg" />

    <!-- SCROLLABLE CENTRAL CONTENT -->
    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="80dp"
            android:paddingBottom="100dp">

            <!-- LOGO ASSET (JUMP ADVENTURE) -->
            <ImageView
                android:id="@+id/ivHomeLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Jump Adventure Logo"
                android:maxWidth="340dp"
                android:scaleType="fitCenter"
                android:src="@drawable/jumpadventurename" />

            <!-- CHARACTER HERO MAIN FOCAL DISPLAY -->
            <com.jumpadventure.game.graphics.CharacterPreviewView
                android:id="@+id/charPreviewView"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp" />

            <!-- MOUNTAIN PLATFORM DIRECTLY UNDER CHARACTER -->
            <ImageView
                android:id="@+id/ivMountainPlatform"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:layout_marginBottom="28dp"
                android:adjustViewBounds="true"
                android:contentDescription="Mountain Platform"
                android:scaleType="fitCenter"
                android:src="@drawable/mountain" />

            <!-- PRIMARY CTA: GLOSSY ORANGE 3D PLAY NOW BUTTON -->
            <LinearLayout
                android:id="@+id/btnPlayContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center">

                <com.jumpadventure.game.graphics.GamePrimaryButton
                    android:id="@+id/btnPlay"
                    android:layout_width="320dp"
                    android:layout_height="78dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- TOP HUD BAR (Settings + Currency Badges) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Custom Blue Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings" />

        <!-- Currency Badges (Coins & Gems) -->
        <LinearLayout
            android:id="@+id/currencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Coins Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1,250"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gems Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_gem" />

                <TextView
                    android:id="@+id/tvGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="35"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- FLOATING WARM-WHITE BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_nav_container"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:weightSum="4">

        <!-- Shop Nav Item -->
        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavShop"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shop" />

            <TextView
                android:id="@+id/tvNavShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Shop"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Heroes Nav Item -->
        <LinearLayout
            android:id="@+id/navCharacters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavCharacters"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_hero" />

            <TextView
                android:id="@+id/tvNavCharacters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Heroes"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Worlds Nav Item -->
        <LinearLayout
            android:id="@+id/navWorlds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavWorlds"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_world" />

            <TextView
                android:id="@+id/tvNavWorlds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Worlds"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trophies Nav Item -->
        <LinearLayout
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivNavAchievements"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_trophy" />

            <TextView
                android:id="@+id/tvNavAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trophies"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
