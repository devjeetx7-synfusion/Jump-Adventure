<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/ivHomeBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Home Background"
        android:scaleType="centerCrop"
        android:src="@drawable/home_bg" />

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:minHeight="64dp"
        android:clipChildren="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings" />

        <LinearLayout
            android:id="@+id/currencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:text="1,250"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:src="@drawable/ic_gem" />

                <TextView
                    android:id="@+id/tvGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:text="35"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bottom_nav_container"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">
            <ImageView
                android:id="@+id/ivNavShop"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shop" />
            <TextView
                android:id="@+id/tvNavShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Shop"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCharacters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">
            <ImageView
                android:id="@+id/ivNavCharacters"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_hero" />
            <TextView
                android:id="@+id/tvNavCharacters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Heroes"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWorlds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">
            <ImageView
                android:id="@+id/ivNavWorlds"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_world" />
            <TextView
                android:id="@+id/tvNavWorlds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Worlds"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">
            <ImageView
                android:id="@+id/ivNavAchievements"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_trophy" />
            <TextView
                android:id="@+id/tvNavAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trophies"
                android:textColor="@color/game_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/homeContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNavContainer"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/ivHomeLogo"
            android:layout_width="310dp"
            android:layout_height="145dp"
            android:layout_gravity="top|center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="Jump Adventure Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/jumpadventurename" />

        <ImageView
            android:id="@+id/ivMountainPlatform"
            android:layout_width="220dp"
            android:layout_height="250dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:adjustViewBounds="true"
            android:contentDescription="Mountain Platform"
            android:scaleType="fitCenter"
            android:src="@drawable/mountain" />

        <com.jumpadventure.game.graphics.CharacterPreviewView
            android:id="@+id/charPreviewView"
            android:layout_width="210dp"
            android:layout_height="225dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="280dp"
            android:clipChildren="false" />

        <com.jumpadventure.game.graphics.GamePrimaryButton
            android:id="@+id/btnPlay"
            android:layout_width="320dp"
            android:layout_height="78dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp" />

    </FrameLayout>

</RelativeLayout>