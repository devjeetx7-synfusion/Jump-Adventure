<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_sky"
    android:fitsSystemWindows="true"
    android:padding="12dp">

    <!-- TOP HUD BAR -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp">

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_game_secondary"
            android:contentDescription="Settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />

        <!-- Currency Pills -->
        <LinearLayout
            android:id="@+id/currencyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Coins Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1,250"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gems Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_gem" />

                <TextView
                    android:id="@+id/tvGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="35"
                    android:textColor="@color/game_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- LOGO & TITLE HEADER -->
    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#8B4500"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="2"
            android:text="JUMP\nADVENTURE"
            android:textAlignment="center"
            android:textColor="#FFCA28"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="PREMIUM PLATFORMER"
            android:textColor="@color/game_text_navy"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CHARACTER DISPLAY AREA -->
    <com.jumpadventure.game.graphics.CharacterPreviewView
        android:id="@+id/charPreviewView"
        android:layout_width="320dp"
        android:layout_height="280dp"
        android:layout_below="@id/logoContainer"
        android:layout_above="@id/btnPlayContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="4dp" />

    <!-- PRIMARY PLAY BUTTON -->
    <LinearLayout
        android:id="@+id/btnPlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_button_game_primary"
            android:text="PLAY NOW\nLevel 1"
            android:textColor="@color/game_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:drawableTop="@drawable/ic_shop"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="SHOP"
            android:textColor="@color/game_text_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navCharacters"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:drawableTop="@drawable/ic_hero"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="HEROES"
            android:textColor="@color/game_text_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navWorlds"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:drawableTop="@drawable/ic_world"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="WORLDS"
            android:textColor="@color/game_text_dark"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_button_game_secondary"
            android:drawableTop="@drawable/ic_trophy"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="TROPHIES"
            android:textColor="@color/game_text_dark"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
