<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Soft Bottom Shadow Layer -->
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Outer Border Bevel -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FFE8B0" />
        </shape>
    </item>

    <!-- Warm Cream Main Panel Body -->
    <item
        android:bottom="6dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#FFF8EA" />
            <stroke
                android:width="2dp"
                android:color="#FFF2D6" />
        </shape>
    </item>

    <!-- Top Glossy Inner Highlight -->
    <item
        android:bottom="40dp"
        android:left="12dp"
        android:right="12dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#A0FFFFFF" />
        </shape>
    </item>
</layer-list>
