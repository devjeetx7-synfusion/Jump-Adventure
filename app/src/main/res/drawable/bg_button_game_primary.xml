<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Outer Bottom Shadow -->
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@color/game_primary_shadow" />
                </shape>
            </item>

            <!-- Main Glossy Body -->
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="@color/game_primary_start"
                        android:endColor="@color/game_primary_end" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#FFF3C4" />
                </shape>
            </item>

            <!-- Top Highlight Glow -->
            <item
                android:bottom="26dp"
                android:left="6dp"
                android:right="6dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
