<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active Capsule 3D Shadow -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/game_secondary_shadow" />
        </shape>
    </item>

    <!-- Active Capsule Glossy Blue Body -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/game_secondary_start"
                android:endColor="@color/game_secondary_end" />
            <stroke
                android:width="1.5dp"
                android:color="#BAE6FD" />
        </shape>
    </item>

    <!-- Top Highlight -->
    <item
        android:bottom="24dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
