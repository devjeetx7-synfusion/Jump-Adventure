<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer -->
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/game_secondary_shadow" />
        </shape>
    </item>

    <!-- Main Button Body Layer -->
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/game_secondary_start"
                android:endColor="@color/game_secondary_end" />
            <stroke
                android:width="2.5dp"
                android:color="#93C5FD" />
        </shape>
    </item>

    <!-- Top Glossy Inner Highlight Layer -->
    <item
        android:top="2dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
